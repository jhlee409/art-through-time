# Copy this file to .env on each local machine. Never commit .env.
ART_ATLAS_ADMIN_EMAIL=your-email@example.com
ART_ATLAS_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Required only for the artist-notes Update button. Source text is sent to OpenAI.
OPENAI_API_KEY=replace-with-your-openai-api-key
# ART_ATLAS_SUMMARY_MODEL=gpt-5-mini

# Optional: absolute path to ffmpeg when it is not on PATH.
# ART_ATLAS_FFMPEG=C:\\ffmpeg\\bin\\ffmpeg.exe
